RewriteEngine On

# Canonical language folders: remove index.php in one hop on every host/scheme.
RewriteRule ^(en|id)/index\.php$ https://asialinen.com/$1/ [R=301,L,NE]
RewriteRule ^index\.php$ https://asialinen.com/en/ [R=301,L,NE]

# Consolidate HTTP and www variants on the canonical HTTPS hostname.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^asialinen\.com$ [NC]
RewriteRule ^ https://asialinen.com%{REQUEST_URI} [R=301,L,NE]
